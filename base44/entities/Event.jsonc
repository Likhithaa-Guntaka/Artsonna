{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "time": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "online",
        "offline"
      ]
    },
    "attendee_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "attendee_count": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "event_date",
    "event_type"
  ]
}