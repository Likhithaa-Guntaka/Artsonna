{
  "name": "PortfolioProject",
  "type": "object",
  "properties": {
    "creator_id": {
      "type": "string"
    },
    "source_project_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cover_image": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "project_date": {
      "type": "string",
      "format": "date"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "creator_id",
    "title"
  ]
}