{
  "name": "PortfolioAsset",
  "type": "object",
  "properties": {
    "profile_id": {
      "type": "string"
    },
    "portfolio_id": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "media_type": {
      "type": "string",
      "enum": [
        "image",
        "video",
        "audio",
        "file"
      ]
    },
    "asset_kind": {
      "type": "string",
      "enum": [
        "work",
        "reference"
      ],
      "default": "work"
    },
    "selected": {
      "type": "boolean",
      "default": true
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "visibility": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    }
  },
  "required": [
    "profile_id",
    "file_url",
    "media_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.visibility": "published"
        },
        {
          "created_by_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}