{
  "name": "CreativeProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "creative_role": {
      "type": "string"
    },
    "neighborhood": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "default": "NYC"
    },
    "short_bio": {
      "type": "string"
    },
    "creative_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "availability": {
      "type": "string"
    },
    "starting_price": {
      "type": "number"
    }
  },
  "required": [
    "user_id",
    "display_name",
    "creative_role",
    "neighborhood",
    "short_bio"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}