{
  "name": "CreativeProfile",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "display_name": {
      "type": "string"
    },
    "profile_photo": {
      "type": "string"
    },
    "creative_role": {
      "type": "string"
    },
    "neighborhood": {
      "type": "string"
    },
    "city": {
      "type": "string",
      "default": "NYC"
    },
    "short_bio": {
      "type": "string"
    },
    "creative_categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "style_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "availability": {
      "type": "string"
    },
    "starting_price": {
      "type": "number"
    },
    "portfolio_theme": {
      "type": "string",
      "enum": [
        "editorial",
        "minimal",
        "bold",
        "raw",
        "playful",
        "cinematic"
      ],
      "default": "editorial"
    },
    "background_style": {
      "type": "string",
      "enum": [
        "light",
        "warm",
        "dark"
      ],
      "default": "light"
    },
    "background_color": {
      "type": "string"
    },
    "text_color": {
      "type": "string"
    },
    "accent_color": {
      "type": "string",
      "default": "#111111"
    },
    "typography_style": {
      "type": "string",
      "enum": [
        "modern",
        "editorial",
        "expressive",
        "classic"
      ],
      "default": "editorial"
    },
    "typography_mood": {
      "type": "string"
    },
    "layout_style": {
      "type": "string",
      "enum": [
        "grid",
        "stacked",
        "asymmetric",
        "full_bleed",
        "mixed"
      ],
      "default": "asymmetric"
    },
    "hero_image": {
      "type": "string"
    },
    "portfolio_intro": {
      "type": "string"
    },
    "portfolio_prompt": {
      "type": "string"
    },
    "portfolio_section_order": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "hidden_sections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "portfolio_status": {
      "type": "string",
      "enum": [
        "draft",
        "published"
      ],
      "default": "draft"
    },
    "marketplace_eligible": {
      "type": "boolean",
      "default": false
    },
    "public_portfolio_slug": {
      "type": "string"
    },
    "existing_portfolio_url": {
      "type": "string"
    },
    "published_date": {
      "type": "string",
      "format": "date-time"
    },
    "open_to_mentor": {
      "type": "boolean",
      "default": false
    },
    "mentor_blurb": {
      "type": "string"
    },
    "circle_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "user_id",
    "display_name",
    "creative_role",
    "neighborhood",
    "short_bio"
  ],
  "rls": {
    "read": {},
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}